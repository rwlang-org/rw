class Counter:
    hits: int
    log: string

def main() -> int:
    total: int = 0
    for i in range(1, 11):
        total += i
    print(total)
    n: int = 100
    n -= 1
    n *= 2
    n /= 3
    n %= 50
    print(n)
    bits: int = 12
    bits &= 10
    bits |= 1
    bits ^= 3
    print(bits)
    f: float = 1.5
    f *= 4.0
    print(f)
    s: string = "a"
    s += "b"
    s += "c"
    print(s)
    c: Counter = Counter(0, "")
    for j in range(0, 3):
        c.hits += 1
        c.log += str_from_int(j)
    print(c.hits)
    print(c.log)
    return 0
