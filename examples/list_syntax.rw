class Point:
    x: int
    y: int

def total(xs: List[int]) -> int:
    s: int = 0
    for x in xs:
        s += x
    return s

def main() -> int:
    names: List[string] = ["ann", "bob", "cy"]
    for name in names:
        print(name)
    print(names[0] + " " + names[-1])
    print(len(names[1:]))
    print(str_join(names[:2], ","))
    print(str_join(names[-2:], ","))
    print(len(names[5:]))
    print(len(names[:]))

    nums: List[int] = [5, 10, 15, 20]
    print(total(nums))
    print(total(nums[1:3]))
    print(nums[-1] - nums[0])

    # Lists are immutable: slicing and pushing make new lists.
    more: List[int] = list_push(nums, 25)
    print(len(nums))
    print(len(more))

    empty: List[int] = []
    print(total(empty))

    grid: List[List[int]] = [[1, 2], [], [3]]
    for row in grid:
        print(len(row))
    print(grid[0][1] + grid[2][0])

    pts: List[Point] = [Point(1, 2), Point(3, 4)]
    for p in pts:
        print(p.x * p.y)

    word: string = "hello"
    print(word[1:4] + word[-1])
    print(word[0])
    print(word[:-2])
    for ch in "abc":
        print(ch)

    # Sibling loops may reuse a variable name with another type.
    for v in ["x", "y"]:
        print(v)
    for v in [7, 8]:
        print(v * 2)

    # break and continue in for-each
    for n in [1, 2, 3, 4, 5, 6]:
        if n == 2:
            continue
        if n == 5:
            break
        print(n)
    return 0
