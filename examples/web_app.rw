# A web application built on examples/web.rw.
import web
import json as js
import url
from web import App, Request, Response, text, html, json, param, query, header, set_header

def index(req: Request) -> Response:
    return html(200, "<h1>Hello from rw</h1>\n")

def hello(req: Request) -> Response:
    return text(200, "hello, " + param(req, "name") + "\n")

def post_of_user(req: Request) -> Response:
    return text(200, "user " + param(req, "id") + " post " + param(req, "post") + "\n")

# Values are escaped by the json module (spec 58), so a quote in ?q= is safe.
def search(req: Request) -> Response:
    body: js.Value = js.object().set("q", js.from_str(query(req, "q"))).set("page", js.from_str(query(req, "page")))
    return json(200, body.dump() + "\n")

def agent(req: Request) -> Response:
    return text(200, header(req, "user-agent") + "\n")

def echo(req: Request) -> Response:
    res: Response = text(201, req.body)
    return set_header(res, "X-Echo-Length", str_from_int(len(req.body)))

# An HTML form POST (application/x-www-form-urlencoded) that sets a cookie.
def login(req: Request) -> Response:
    user: string = web.form(req, "user")
    if user == "":
        return text(400, "user required\n")
    res: Response = text(200, "welcome, " + user + "\n")
    return web.set_cookie(res, "user", url.escape(user))

def whoami(req: Request) -> Response:
    user: string = url.unescape(web.cookie(req, "user"))
    if user == "":
        return text(401, "not logged in\n")
    return text(200, "you are " + user + "\n")

# Middleware (spec 63): /admin needs a token; every response says who served it.
def require_token(req: Request) -> Option[Response]:
    if str_starts_with(req.path, "/admin") and web.header(req, "X-Token") != "secret":
        return Some(text(403, "forbidden\n"))
    return None

def powered_by(req: Request, res: Response) -> Response:
    return set_header(res, "X-Powered-By", "rw")

def admin(req: Request) -> Response:
    return text(200, "admin area\n")

def old(req: Request) -> Response:
    return web.redirect("/")

def missing(req: Request) -> Response:
    return html(404, "<p>no page at " + req.path + "</p>\n")

def main() -> int:
    app: App = web.new_app()
    web.get(app, "/", index)
    web.get(app, "/hello/:name", hello)
    web.get(app, "/users/:id/posts/:post", post_of_user)
    web.get(app, "/search", search)
    web.get(app, "/agent", agent)
    web.post(app, "/echo", echo)
    web.post(app, "/login", login)
    web.get(app, "/whoami", whoami)
    web.get(app, "/old", old)
    web.get(app, "/admin", admin)
    web.before(app, require_token)
    web.after(app, powered_by)
    # Static files: examples/public by default (run from the repository root).
    public: string = "examples/public"
    match os_getenv("WEB_PUBLIC"):
        case Some(dir):
            public = dir
        case None:
            public = public
    web.static(app, "/static", public)
    web.set_not_found(app, missing)
    return web.serve(app, 8080)
