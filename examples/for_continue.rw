# `continue` in a range-for must still advance the loop variable.
def main() -> int:
    for i in range(0, 6):
        if i == 2:
            continue
        if i == 5:
            break
        print(i)
    total: int = 0
    for j in range(10, 0, -2):
        if j == 6:
            continue
        for k in range(0, 3):
            if k == 1:
                continue
            total = total + j * 10 + k
    print(total)
    n: int = 0
    while n < 5:
        n = n + 1
        if n % 2 == 0:
            continue
        print(n)
    return 0
