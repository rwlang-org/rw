class User:
    name: string
    age: int

def main() -> int:
    names = str_split("ann,bob,cy", ",")
    total = 0
    for n in names:
        total += len(n)
    print(total)
    users = [User("ann", 31), User("bob", 25)]
    oldest = users[0]
    for u in users:
        if u.age > oldest.age:
            oldest = u
    print(oldest.name)
    ages: Dict[string, int] = dict_new()
    for u in users:
        ages[u.name] = u.age
    found = dict_get(ages, "bob")
    match found:
        case Some(a):
            print(a)
        case None:
            print("none")
    ratio = float(total) / 4.0
    print(ratio)

    # The same name declared in sibling blocks with different types.
    flag = true
    if flag:
        v = "text"
        print(v)
    else:
        v = 42
        print(v)
    if not flag:
        w = 1.5
        print(w)
    else:
        w = [1, 2, 3]
        print(len(w))
    return 0
