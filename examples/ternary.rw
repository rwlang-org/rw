def classify(n: int) -> int:
    # nested conditional expression (right-associative)
    return 1 if n > 0 else 0 if n == 0 else -1

def main() -> int:
    a: int = 10
    b: int = 20
    # int branches: pick the larger
    larger: int = a if a > b else b
    print(larger)            # 20

    # string branches selected by a bool condition
    label: string = "even" if a % 2 == 0 else "odd"
    print(label)             # even

    # bool branches
    ok: bool = true if larger == 20 else false
    print(ok)                # true

    # nested ternary via a helper
    print(classify(5))       # 1
    print(classify(0))       # 0
    print(classify(-3))      # -1
    return 0
