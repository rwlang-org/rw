def handle_client(fd: int) -> int:
    welcome: string = "welcome to rw chat. type 'quit' to leave.\n> "
    tcp_write(fd, bytes_from_str(welcome))
    while true:
        b: Bytes = tcp_read(fd, 4096)
        if len(b) == 0:
            tcp_close(fd)
            return 0
        s: string = str_from_bytes(b)
        reply: string = "you said: " + s + "> "
        tcp_write(fd, bytes_from_str(reply))
    return 0

def main() -> int:
    listen_fd: int = tcp_listen(8080)
    while true:
        client: int = tcp_accept(listen_fd)
        spawn handle_client(client)
    return 0
