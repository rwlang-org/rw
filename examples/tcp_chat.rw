# Line-oriented chat server: each line typed gets echoed back. Uses the
# buffered Reader from the standard library (spec 54).
import bufio

def handle_client(fd: int) -> int:
    write_all(fd, bytes_from_str("welcome to rw chat. type 'quit' to leave.\n> "))
    r = bufio.reader(fd)
    done = false
    while not done:
        match r.read_line():
            case Some(line):
                if line == "quit":
                    write_all(fd, bytes_from_str("bye\n"))
                    done = true
                else:
                    write_all(fd, bytes_from_str("you said: " + line + "\n> "))
            case None:
                done = true
    close(fd)
    return 0

def main() -> int:
    listen_fd: int = tcp_listen(8080)
    while true:
        client: int = tcp_accept(listen_fd)
        spawn handle_client(client)
    return 0
