# Locals declared inside a loop must not grow the stack on every iteration.
# Fiber stacks are 64 KiB, so this crashed (SIGBUS / SIGSEGV) when each
# declaration was a fresh alloca inside the loop body.
def work(n: int) -> int:
    total: int = 0
    i: int = 0
    while i < n:
        s: string = "abc"
        x: int = len(s)
        o: Option[int] = str_to_int("7")
        match o:
            case Some(v):
                total = total + x + v
            case None:
                total = total - 1
        i = i + 1
    return total

def main() -> int:
    f: Future[int] = spawn work(200000)
    print(await f)
    return 0
