# web.rw — a small web application framework written in rw.
#
#   from web import App, Request, Response, text, param
#
#   def hello(req: Request) -> Response:
#       return text(200, "hello, " + param(req, "name") + "\n")
#
#   def main() -> int:
#       app: App = web.new_app()
#       web.get(app, "/hello/:name", hello)
#       return web.serve(app, 8080)
#
# See docs/web-framework.md for the full API.

class Header:
    name: string
    value: string

class Request:
    method: string
    path: string
    query: string
    headers: List[Header]
    params: List[Header]
    body: string

class Response:
    status: int
    headers: List[Header]
    body: string

class Route:
    method: string
    pattern: string
    handler: Callable[[Request], Response]

class App:
    routes: List[Route]
    not_found: Callable[[Request], Response]
    log: bool

# Result of matching a route pattern against a path.
class Match:
    ok: bool
    params: List[Header]

# ---------- requests ----------

# Case-insensitive lookup; "" when absent.
def lookup(pairs: List[Header], name: string) -> string:
    want: string = str_lower(name)
    for i in range(0, len(pairs)):
        h: Header = list_at(pairs, i)
        if str_lower(h.name) == want:
            return h.value
    return ""

def header(req: Request, name: string) -> string:
    return lookup(req.headers, name)

# A path parameter captured by a `:name` segment; "" when absent.
def param(req: Request, name: string) -> string:
    for i in range(0, len(req.params)):
        p: Header = list_at(req.params, i)
        if p.name == name:
            return p.value
    return ""

# A query-string value (`?a=1&b=2`); "" when absent. No percent-decoding.
def query(req: Request, name: string) -> string:
    if len(req.query) == 0:
        return ""
    pairs: List[string] = str_split(req.query, "&")
    for i in range(0, len(pairs)):
        kv: string = list_at(pairs, i)
        eq: int = str_find(kv, "=")
        key: string = kv if eq < 0 else str_slice(kv, 0, eq)
        if key == name:
            return "" if eq < 0 else str_slice(kv, eq + 1, len(kv))
    return ""

# ---------- responses ----------

def response(status: int, content_type: string, body: string) -> Response:
    hs: List[Header] = list_new()
    hs = list_push(hs, Header("Content-Type", content_type))
    return Response(status, hs, body)

def text(status: int, body: string) -> Response:
    return response(status, "text/plain; charset=utf-8", body)

def html(status: int, body: string) -> Response:
    return response(status, "text/html; charset=utf-8", body)

def json(status: int, body: string) -> Response:
    return response(status, "application/json", body)

def redirect(location: string) -> Response:
    res: Response = text(302, "")
    return set_header(res, "Location", location)

def set_header(res: Response, name: string, value: string) -> Response:
    res.headers = list_push(res.headers, Header(name, value))
    return res

def reason(status: int) -> string:
    if status == 200:
        return "OK"
    if status == 201:
        return "Created"
    if status == 204:
        return "No Content"
    if status == 301:
        return "Moved Permanently"
    if status == 302:
        return "Found"
    if status == 304:
        return "Not Modified"
    if status == 400:
        return "Bad Request"
    if status == 401:
        return "Unauthorized"
    if status == 403:
        return "Forbidden"
    if status == 404:
        return "Not Found"
    if status == 405:
        return "Method Not Allowed"
    if status == 413:
        return "Content Too Large"
    if status == 431:
        return "Request Header Fields Too Large"
    if status == 500:
        return "Internal Server Error"
    return "Unknown"

# ---------- application and routing ----------

def default_not_found(req: Request) -> Response:
    return text(404, "not found: " + req.path + "\n")

def new_app() -> App:
    return App(list_new(), default_not_found, true)

def route(app: App, method: string, pattern: string, handler: Callable[[Request], Response]) -> App:
    app.routes = list_push(app.routes, Route(method, pattern, handler))
    return app

def get(app: App, pattern: string, handler: Callable[[Request], Response]) -> App:
    return route(app, "GET", pattern, handler)

def post(app: App, pattern: string, handler: Callable[[Request], Response]) -> App:
    return route(app, "POST", pattern, handler)

def set_not_found(app: App, handler: Callable[[Request], Response]) -> App:
    app.not_found = handler
    return app

def set_log(app: App, on: bool) -> App:
    app.log = on
    return app

# Match "/users/:id" against "/users/42": segments must be equal, and a
# `:name` segment captures any non-empty segment.
def match_path(pattern: string, path: string) -> Match:
    ps: List[string] = str_split(pattern, "/")
    xs: List[string] = str_split(path, "/")
    if len(ps) != len(xs):
        return Match(false, list_new())
    params: List[Header] = list_new()
    for i in range(0, len(ps)):
        p: string = list_at(ps, i)
        x: string = list_at(xs, i)
        if str_starts_with(p, ":"):
            if len(x) == 0:
                return Match(false, list_new())
            params = list_push(params, Header(str_slice(p, 1, len(p)), x))
        elif p != x:
            return Match(false, list_new())
    return Match(true, params)

# The first route whose pattern and method match handles the request. A path
# that matches only with other methods is a 405.
def dispatch(app: App, req: Request) -> Response:
    path_matched: bool = false
    for i in range(0, len(app.routes)):
        r: Route = list_at(app.routes, i)
        m: Match = match_path(r.pattern, req.path)
        if m.ok:
            if r.method == req.method:
                req.params = m.params
                return r.handler(req)
            path_matched = true
    if path_matched:
        return text(405, "method not allowed\n")
    return app.not_found(req)

# ---------- HTTP/1.1 over TCP ----------

# Limits for a single request.
def max_header_bytes() -> int:
    return 65536

def max_body_bytes() -> int:
    return 1048576

def bad_request(why: string) -> Request:
    # method "" marks a request that could not be read; path says why.
    return Request("", why, "", list_new(), list_new(), "")

def read_request(fd: int) -> Request:
    buf: string = ""
    while str_find(buf, "\r\n\r\n") < 0:
        b: Bytes = read(fd, 4096)
        if len(b) == 0:
            return bad_request("eof" if len(buf) == 0 else "bad")
        buf = buf + str_from_bytes(b)
        if len(buf) > max_header_bytes():
            return bad_request("too-large")
    head_end: int = str_find(buf, "\r\n\r\n")
    lines: List[string] = str_split(str_slice(buf, 0, head_end), "\r\n")
    parts: List[string] = str_split(list_at(lines, 0), " ")
    if len(parts) != 3:
        return bad_request("bad")
    target: string = list_at(parts, 1)
    q: int = str_find(target, "?")
    path: string = target if q < 0 else str_slice(target, 0, q)
    query_s: string = "" if q < 0 else str_slice(target, q + 1, len(target))
    headers: List[Header] = list_new()
    for i in range(1, len(lines)):
        line: string = list_at(lines, i)
        c: int = str_find(line, ":")
        if c > 0:
            headers = list_push(headers, Header(str_strip(str_slice(line, 0, c)), str_strip(str_slice(line, c + 1, len(line)))))
    body: string = str_slice(buf, head_end + 4, len(buf))
    match str_to_int(lookup(headers, "Content-Length")):
        case Some(n):
            if n > max_body_bytes():
                return bad_request("too-large")
            while len(body) < n:
                more: Bytes = read(fd, 4096)
                if len(more) == 0:
                    return bad_request("bad")
                body = body + str_from_bytes(more)
            body = str_slice(body, 0, n)
        case None:
            body = ""
    return Request(list_at(parts, 0), path, query_s, headers, list_new(), body)

def serialize(res: Response) -> string:
    out: string = "HTTP/1.1 " + str_from_int(res.status) + " " + reason(res.status) + "\r\n"
    for i in range(0, len(res.headers)):
        h: Header = list_at(res.headers, i)
        out = out + h.name + ": " + h.value + "\r\n"
    out = out + "Content-Length: " + str_from_int(len(res.body)) + "\r\n"
    out = out + "Connection: close\r\n\r\n"
    return out + res.body

# write() may write only part of the buffer; keep going until all is sent.
def write_all(fd: int, s: string) -> int:
    off: int = 0
    while off < len(s):
        n: int = write(fd, bytes_from_str(str_slice(s, off, len(s))))
        if n <= 0:
            return -1
        off = off + n
    return off

def handle_conn(app: App, fd: int) -> int:
    req: Request = read_request(fd)
    if req.method == "" and req.path == "eof":
        return close(fd)
    res: Response = text(400, "bad request\n")
    if req.method == "" and req.path == "too-large":
        res = text(413, "request too large\n")
    elif req.method != "":
        res = dispatch(app, req)
    write_all(fd, serialize(res))
    if app.log:
        print(req.method + " " + req.path + " " + str_from_int(res.status))
    return close(fd)

# Listen on `port` and handle each connection in its own fiber. Only returns
# if the port cannot be opened.
def serve(app: App, port: int) -> int:
    listen_fd: int = tcp_listen(port)
    if listen_fd < 0:
        print("web: cannot listen on port " + str_from_int(port))
        return 1
    while true:
        client: int = tcp_accept(listen_fd)
        spawn handle_conn(app, client)
    return 0
