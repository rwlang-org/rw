# web.rw — a small web application framework written in rw.
#
#   from web import App, Request, Response, text, param
#
#   def hello(req: Request) -> Response:
#       return text(200, "hello, " + param(req, "name") + "\n")
#
#   def main() -> int:
#       app: App = web.new_app()
#       web.get(app, "/hello/:name", hello)
#       return web.serve(app, 8080)
#
# See docs/web-framework.md for the full API.
import bufio
import fs
import log
import path
import url

class Header:
    name: string
    value: string

class Request:
    method: string
    path: string
    query: string
    headers: List[Header]
    params: List[Header]
    body: string
    version: string    # "HTTP/1.1" or "HTTP/1.0"

class Response:
    status: int
    headers: List[Header]
    body: string

class Route:
    method: string
    pattern: string
    handler: Callable[[Request], Response]

# A directory served under a URL prefix (spec 63).
class Mount:
    prefix: string
    root: string

class App:
    routes: List[Route]
    not_found: Callable[[Request], Response]
    # Middleware (spec 63): `before` hooks run in order ahead of routing and
    # may answer instead (Some); `after` hooks rewrite every response.
    befores: List[Callable[[Request], Option[Response]]]
    afters: List[Callable[[Request, Response], Response]]
    mounts: List[Mount]
    log: bool
    # Access log and server messages (spec 60); stdout by default.
    logger: log.Logger
    # Per-connection read/write timeout in ms (spec 53); 0 disables it.
    timeout_ms: int
    # How long an idle keep-alive connection waits for its next request
    # (spec 64); 0 closes every connection after one response.
    keepalive_ms: int

# Result of matching a route pattern against a path.
class Match:
    ok: bool
    params: List[Header]

# ---------- requests ----------

# Case-insensitive lookup; "" when absent.
def lookup(pairs: List[Header], name: string) -> string:
    want: string = str_lower(name)
    for i in range(0, len(pairs)):
        h: Header = list_at(pairs, i)
        if str_lower(h.name) == want:
            return h.value
    return ""

def header(req: Request, name: string) -> string:
    return lookup(req.headers, name)

# A path parameter captured by a `:name` segment; "" when absent.
def param(req: Request, name: string) -> string:
    for i in range(0, len(req.params)):
        p: Header = list_at(req.params, i)
        if p.name == name:
            return p.value
    return ""

# The first value of a query-string parameter (`?a=1&b=x+y`), decoded
# (spec 62); "" when absent.
def query(req: Request, name: string) -> string:
    match url.get(url.parse_query(req.query), name):
        case Some(v):
            return v
        case None:
            return ""

# A field of an `application/x-www-form-urlencoded` body (an HTML form
# POST), decoded; "" when absent or when the body is another type.
def form(req: Request, name: string) -> string:
    if not str_starts_with(str_lower(header(req, "Content-Type")), "application/x-www-form-urlencoded"):
        return ""
    match url.get(url.parse_query(req.body), name):
        case Some(v):
            return v
        case None:
            return ""

# A cookie sent by the client (`Cookie: a=1; b=2`); "" when absent.
def cookie(req: Request, name: string) -> string:
    for part in str_split(header(req, "Cookie"), ";"):
        kv: string = str_strip(part)
        eq: int = str_find(kv, "=")
        if eq > 0 and str_slice(kv, 0, eq) == name:
            return str_slice(kv, eq + 1, len(kv))
    return ""

# ---------- responses ----------

def response(status: int, content_type: string, body: string) -> Response:
    hs: List[Header] = list_new()
    hs = list_push(hs, Header("Content-Type", content_type))
    return Response(status, hs, body)

def text(status: int, body: string) -> Response:
    return response(status, "text/plain; charset=utf-8", body)

def html(status: int, body: string) -> Response:
    return response(status, "text/html; charset=utf-8", body)

def json(status: int, body: string) -> Response:
    return response(status, "application/json", body)

def redirect(location: string) -> Response:
    res: Response = text(302, "")
    return set_header(res, "Location", location)

def set_header(res: Response, name: string, value: string) -> Response:
    res.headers = list_push(res.headers, Header(name, value))
    return res

# Add a Set-Cookie header. `attrs` follows the value verbatim; the default
# keeps the cookie away from scripts and cross-site requests.
def set_cookie(res: Response, name: string, value: string, attrs: string = "Path=/; HttpOnly; SameSite=Lax") -> Response:
    v: string = name + "=" + value
    if attrs != "":
        v = v + "; " + attrs
    return set_header(res, "Set-Cookie", v)

def reason(status: int) -> string:
    if status == 200:
        return "OK"
    if status == 201:
        return "Created"
    if status == 204:
        return "No Content"
    if status == 301:
        return "Moved Permanently"
    if status == 302:
        return "Found"
    if status == 304:
        return "Not Modified"
    if status == 400:
        return "Bad Request"
    if status == 401:
        return "Unauthorized"
    if status == 403:
        return "Forbidden"
    if status == 404:
        return "Not Found"
    if status == 405:
        return "Method Not Allowed"
    if status == 413:
        return "Content Too Large"
    if status == 431:
        return "Request Header Fields Too Large"
    if status == 500:
        return "Internal Server Error"
    return "Unknown"

# ---------- application and routing ----------

def default_not_found(req: Request) -> Response:
    return text(404, "not found: " + req.path + "\n")

def new_app() -> App:
    lg: log.Logger = log.new(1)
    lg.prefix = "web"
    return App(list_new(), default_not_found, [], [], [], true, lg, 10000, 5000)

def route(app: App, method: string, pattern: string, handler: Callable[[Request], Response]) -> App:
    app.routes = list_push(app.routes, Route(method, pattern, handler))
    return app

def get(app: App, pattern: string, handler: Callable[[Request], Response]) -> App:
    return route(app, "GET", pattern, handler)

def post(app: App, pattern: string, handler: Callable[[Request], Response]) -> App:
    return route(app, "POST", pattern, handler)

def set_not_found(app: App, handler: Callable[[Request], Response]) -> App:
    app.not_found = handler
    return app

def set_log(app: App, on: bool) -> App:
    app.log = on
    return app

def before(app: App, hook: Callable[[Request], Option[Response]]) -> App:
    app.befores = list_push(app.befores, hook)
    return app

def after(app: App, hook: Callable[[Request, Response], Response]) -> App:
    app.afters = list_push(app.afters, hook)
    return app

# Serve the files under directory `root` at URL `prefix` ("/static" maps
# "/static/css/a.css" to "<root>/css/a.css"). Only GET and HEAD.
def static(app: App, prefix: string, root: string) -> App:
    p: string = prefix
    while str_ends_with(p, "/"):
        p = str_slice(p, 0, len(p) - 1)
    app.mounts = list_push(app.mounts, Mount(p, root))
    return app

# ---------- static files ----------

def content_type_for(file: string) -> string:
    e: string = str_lower(path.ext(file))
    if e == ".html" or e == ".htm":
        return "text/html; charset=utf-8"
    if e == ".css":
        return "text/css; charset=utf-8"
    if e == ".js" or e == ".mjs":
        return "text/javascript; charset=utf-8"
    if e == ".json":
        return "application/json"
    if e == ".txt" or e == ".md":
        return "text/plain; charset=utf-8"
    if e == ".svg":
        return "image/svg+xml"
    if e == ".png":
        return "image/png"
    if e == ".jpg" or e == ".jpeg":
        return "image/jpeg"
    if e == ".gif":
        return "image/gif"
    if e == ".webp":
        return "image/webp"
    if e == ".ico":
        return "image/x-icon"
    if e == ".wasm":
        return "application/wasm"
    if e == ".pdf":
        return "application/pdf"
    return "application/octet-stream"

def pad2(n: int) -> string:
    return str(n) if n >= 10 else "0" + str(n)

# Unix time in ms as an HTTP date: "Tue, 13 Oct 2026 01:02:03 GMT".
def http_date(ms: int) -> string:
    secs: int = ms / 1000
    days: int = secs / 86400
    rem: int = secs % 86400
    wd: List[string] = ["Thu", "Fri", "Sat", "Sun", "Mon", "Tue", "Wed"]
    months: List[string] = ["Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"]
    z: int = days + 719468
    era: int = z / 146097
    doe: int = z - era * 146097
    yoe: int = (doe - doe / 1460 + doe / 36524 - doe / 146096) / 365
    doy: int = doe - (365 * yoe + yoe / 4 - yoe / 100)
    mp: int = (5 * doy + 2) / 153
    d: int = doy - (153 * mp + 2) / 5 + 1
    m: int = mp + 3 if mp < 10 else mp - 9
    y: int = yoe + era * 400 + (1 if m <= 2 else 0)
    return wd[days % 7] + ", " + pad2(d) + " " + months[m - 1] + " " + str(y) + " " + pad2(rem / 3600) + ":" + pad2(rem / 60 % 60) + ":" + pad2(rem % 60) + " GMT"

# The response for a mounted file, or None if no mount covers the path.
# Paths that would leave the root (".." or an absolute part) and missing
# files are 404s; a directory serves its index.html. Last-Modified is sent,
# and a matching If-Modified-Since gets 304.
def serve_static(app: App, req: Request) -> Option[Response]:
    if req.method != "GET" and req.method != "HEAD":
        return None
    for m in app.mounts:
        if req.path == m.prefix or str_starts_with(req.path, m.prefix + "/"):
            rel: string = url.unescape(str_slice(req.path, len(m.prefix), len(req.path)), false)
            while str_starts_with(rel, "/"):
                rel = str_slice(rel, 1, len(rel))
            match path.join_under(m.root, rel):
                case Some(file):
                    target: string = path.join(file, "index.html") if fs.is_dir(file) else file
                    match fs.stat(target):
                        case Some(st):
                            if st.kind != "file":
                                return Some(app.not_found(req))
                            modified: string = http_date(st.mtime_ms)
                            if header(req, "If-Modified-Since") == modified:
                                return Some(set_header(Response(304, [], ""), "Last-Modified", modified))
                            match fs.read_file(target):
                                case Some(body):
                                    res: Response = response(200, content_type_for(target), body)
                                    return Some(set_header(res, "Last-Modified", modified))
                                case None:
                                    return Some(text(500, "cannot read file\n"))
                        case None:
                            return Some(app.not_found(req))
                case None:
                    return Some(app.not_found(req))
    return None

# Match "/users/:id" against "/users/42": segments must be equal, and a
# `:name` segment captures any non-empty segment. Path segments are
# percent-decoded after splitting (spec 62), so "%2F" stays inside one.
def match_path(pattern: string, path: string) -> Match:
    ps: List[string] = str_split(pattern, "/")
    xs: List[string] = str_split(path, "/")
    if len(ps) != len(xs):
        return Match(false, list_new())
    params: List[Header] = list_new()
    for i in range(0, len(ps)):
        p: string = list_at(ps, i)
        x: string = url.unescape(list_at(xs, i), false)
        if str_starts_with(p, ":"):
            if len(x) == 0:
                return Match(false, list_new())
            params = list_push(params, Header(str_slice(p, 1, len(p)), x))
        elif p != x:
            return Match(false, list_new())
    return Match(true, params)

# The first route whose pattern and method match handles the request. A path
# that matches only with other methods is a 405.
def dispatch(app: App, req: Request) -> Response:
    path_matched: bool = false
    for i in range(0, len(app.routes)):
        r: Route = list_at(app.routes, i)
        m: Match = match_path(r.pattern, req.path)
        if m.ok:
            if r.method == req.method:
                req.params = m.params
                return r.handler(req)
            path_matched = true
    if path_matched:
        return text(405, "method not allowed\n")
    return app.not_found(req)

# ---------- HTTP/1.1 over TCP ----------

# Limits for a single request.
def max_header_bytes() -> int:
    return 65536

def max_body_bytes() -> int:
    return 1048576

def bad_request(why: string) -> Request:
    # method "" marks a request that could not be read; path says why.
    return Request("", why, "", list_new(), list_new(), "", "")

# Read one request from the connection's reader; bytes after it (a
# pipelined request) stay buffered for the next call.
def read_request(r: bufio.Reader) -> Request:
    lines: List[string] = []
    size: int = 0
    while true:
        line: string = r.read_until("\n", max_header_bytes() - size + 1)
        size += len(line)
        if not str_ends_with(line, "\n"):
            if size > max_header_bytes():
                return bad_request("too-large")
            if size == 0:
                return bad_request("eof")
            if error_name(r.err) == "ETIMEDOUT":
                return bad_request("timeout")
            return bad_request("bad")
        line = str_strip(line)
        if line == "":
            break
        lines = list_push(lines, line)
    if len(lines) == 0:
        return bad_request("bad")
    parts: List[string] = str_split(list_at(lines, 0), " ")
    if len(parts) != 3:
        return bad_request("bad")
    version: string = list_at(parts, 2)
    if version != "HTTP/1.1" and version != "HTTP/1.0":
        return bad_request("bad")
    target: string = list_at(parts, 1)
    q: int = str_find(target, "?")
    path: string = target if q < 0 else str_slice(target, 0, q)
    query_s: string = "" if q < 0 else str_slice(target, q + 1, len(target))
    headers: List[Header] = list_new()
    for i in range(1, len(lines)):
        h: string = list_at(lines, i)
        c: int = str_find(h, ":")
        if c > 0:
            headers = list_push(headers, Header(str_strip(str_slice(h, 0, c)), str_strip(str_slice(h, c + 1, len(h)))))
    body: string = ""
    match str_to_int(lookup(headers, "Content-Length")):
        case Some(n):
            if n > max_body_bytes():
                return bad_request("too-large")
            body = str_from_bytes(r.read_exact(n))
            if len(body) < n:
                return bad_request("bad")
        case None:
            body = ""
    return Request(list_at(parts, 0), path, query_s, headers, list_new(), body, version)

# The response as bytes on the wire. A HEAD response carries the headers of
# the GET response (Content-Length included) but no body.
def serialize(res: Response, head_only: bool = false, keep_alive: bool = false) -> string:
    out: string = "HTTP/1.1 " + str_from_int(res.status) + " " + reason(res.status) + "\r\n"
    for i in range(0, len(res.headers)):
        h: Header = list_at(res.headers, i)
        out = out + h.name + ": " + h.value + "\r\n"
    out = out + "Content-Length: " + str_from_int(len(res.body)) + "\r\n"
    out = out + ("Connection: keep-alive\r\n\r\n" if keep_alive else "Connection: close\r\n\r\n")
    if head_only:
        return out
    return out + res.body

# Close after a response without resetting the connection. If the client sent
# more than was read (a refused body, say), closing at once makes the kernel
# answer with RST, which can destroy the response before the client reads it.
# So half-close, then discard what is left for a short while (spec 56).
def linger_close(fd: int) -> int:
    shutdown(fd, "write")
    set_read_timeout(fd, 500)
    drained: int = 0
    while drained < 1048576:
        b: Bytes = read(fd, 65536)
        if len(b) == 0:
            break
        drained += len(b)
    return close(fd)

# Middleware, static files, then routes (spec 63). HEAD is routed as GET.
def respond(app: App, req: Request) -> Response:
    res: Response = text(500, "no response\n")
    answered: bool = false
    for hook in app.befores:
        if not answered:
            match hook(req):
                case Some(r):
                    res = r
                    answered = true
                case None:
                    answered = false
    if not answered:
        match serve_static(app, req):
            case Some(r):
                res = r
                answered = true
            case None:
                answered = false
    if not answered:
        method: string = req.method
        if method == "HEAD":
            req.method = "GET"
        res = dispatch(app, req)
        req.method = method
    for hook in app.afters:
        res = hook(req, res)
    return res

# Connections being served, so shutdown can wait for them (spec 57).
class Inflight:
    count: int
    mu: Mutex
    stopping: bool   # set on SIGINT / SIGTERM: finish, then close

def inflight_add(f: Inflight, d: int) -> int:
    mutex_lock(f.mu)
    f.count += d
    n: int = f.count
    mutex_unlock(f.mu)
    return n

# Whether the client lets the connection stay open (spec 64): HTTP/1.1
# unless it sent "Connection: close", HTTP/1.0 only with "keep-alive". A
# chunked request body cannot be skipped reliably, so it ends the connection.
def wants_keep_alive(req: Request) -> bool:
    c: string = str_lower(header(req, "Connection"))
    if header(req, "Transfer-Encoding") != "":
        return false
    if req.version == "HTTP/1.1":
        return not str_contains(c, "close")
    return str_contains(c, "keep-alive")

# Wait up to app.keepalive_ms for the first byte of the next request. Waits
# in short slices so a shutdown (f.stopping) is noticed quickly. False if
# the client closed, the time ran out, or the server is stopping.
def await_next(app: App, r: bufio.Reader, fd: int, f: Inflight) -> bool:
    waited: int = 0
    while waited < app.keepalive_ms:
        if r.buffered() > 0:
            return true
        if f.stopping:
            return false
        set_read_timeout(fd, 200)
        if r.fill():
            return true
        if error_name(r.err) != "ETIMEDOUT":
            return false
        r.eof = false   # a timeout is not the end of the stream
        r.err = 0
        waited += 200
    return false

# One connection: requests in a loop while both sides keep it alive.
def serve_conn(app: App, fd: int, f: Inflight) -> int:
    r: bufio.Reader = bufio.reader(fd)
    served: int = 0
    while true:
        if served > 0 and not await_next(app, r, fd, f):
            break
        set_read_timeout(fd, app.timeout_ms)
        set_write_timeout(fd, app.timeout_ms)
        req: Request = read_request(r)
        if req.method == "" and req.path == "eof":
            break
        res: Response = text(400, "bad request\n")
        if req.method == "" and req.path == "too-large":
            res = text(413, "request too large\n")
        elif req.method == "" and req.path == "timeout":
            res = text(408, "request timeout\n")
        elif req.method != "":
            res = respond(app, req)
        served += 1
        keep: bool = req.method != "" and app.keepalive_ms > 0 and served < 1000 and not f.stopping and wants_keep_alive(req)
        write_all(fd, bytes_from_str(serialize(res, req.method == "HEAD", keep)))
        if app.log:
            app.logger.info(req.method + " " + req.path + " " + str_from_int(res.status))
        if not keep:
            break
    linger_close(fd)
    inflight_add(f, -1)
    return 0

# On SIGINT / SIGTERM, close the listener: the accept loop in serve() then
# gets EBADF and stops taking new connections.
def stop_on_signal(app: App, listen_fd: int, f: Inflight) -> int:
    sig: string = signal_wait(["SIGINT", "SIGTERM"])
    if app.log:
        app.logger.info(sig + ", shutting down")
    f.stopping = true   # idle keep-alive connections close at once
    close(listen_fd)
    return 0

# Listen on `port` and handle each connection in its own fiber. Returns 1 if
# the port cannot be opened, and 0 after a graceful shutdown: on SIGINT or
# SIGTERM it stops accepting, lets the requests in progress finish, then
# returns.
def serve(app: App, port: int) -> int:
    listen_fd: int = tcp_listen(port)
    if listen_fd < 0:
        app.logger.error("cannot listen on port " + str_from_int(port))
        return 1
    f: Inflight = Inflight(0, mutex_new(), false)
    spawn stop_on_signal(app, listen_fd, f)
    while true:
        client: int = tcp_accept(listen_fd)
        if client < 0:
            if error_name(last_error()) == "EBADF":
                break
            sleep(10)  # e.g. EMFILE: back off instead of spinning
            continue
        inflight_add(f, 1)
        spawn serve_conn(app, client, f)
    while inflight_add(f, 0) > 0:
        sleep(10)
    return 0
